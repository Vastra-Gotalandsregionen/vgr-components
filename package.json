{
  "name": "vgr-components",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "npm test -w packages/core",
    "build:tokens": "npm run build -w packages/tokens",
    "build:core": "npm run build -w packages/core",
    "build:react": "npm run build -w packages/react",
    "build:angular": "npm run build -w packages/angular",
    "build:vue": "npm run build -w packages/vue",
    "build:all": "npm run build:tokens && npm run build:core && npm run build:react && npm run build:angular && npm run build:vue",
    "dev:core": "npm run dev -w packages/core",
    "dev:react": "npm run dev -w apps/react-sandbox",
    "dev:angular": "npm run start -w apps/angular-sandbox",
    "dev:vue": "npm run dev -w apps/vue-sandbox",
    "storybook": "npm run storybook -w apps/storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:diff": "prettier --write --list-different ."
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "prettier": "3.9.6",
    "prettier-plugin-vue": "1.1.6"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
